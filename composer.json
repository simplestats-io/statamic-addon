{
    "name": "simplestats-io/statamic-addon",
    "description": "SimpleStats analytics dashboard for Statamic",
    "keywords": [
        "simplestats-io",
        "statamic",
        "statamic-addon",
        "analytics",
        "dashboard",
        "revenue-attribution"
    ],
    "homepage": "https://github.com/simplestats-io/statamic-addon",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "Zacharias Creutznacher",
            "email": "zacharias.creutznacher@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "SimpleStatsIo\\StatamicAddon\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimpleStatsIo\\StatamicAddon\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "SimpleStats",
            "description": "Visitor, revenue and source analytics powered by simplestats.io"
        },
        "laravel": {
            "providers": [
                "SimpleStatsIo\\StatamicAddon\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
